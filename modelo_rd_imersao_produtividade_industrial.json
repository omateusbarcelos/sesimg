  "html_content": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n  <title>Imersão Produtividade Industrial</title>\n  <style>\n    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\n    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; }\n    table { border-collapse: collapse !important; }\n    body { margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #f4f6fb; }\n    .desktop-padding { padding-left: 42px; padding-right: 42px; }\n    .mobile-stack { vertical-align: top; }\n    @media screen and (max-width: 620px) {\n      .email-container { width: 100% !important; max-width: 100% !important; }\n      .desktop-padding { padding-left: 24px !important; padding-right: 24px !important; }\n      .mobile-stack { display: block !important; width: 100% !important; max-width: 100% !important; }\n      .mobile-center { text-align: center !important; }\n      .mobile-img { margin: 0 auto !important; }\n      .hero-title { font-size: 32px !important; line-height: 36px !important; }\n      .section-title { font-size: 24px !important; line-height: 30px !important; }\n      .button-table { width: 100% !important; }\n      .button-link { display: block !important; }\n    }\n  </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f6fb;\">\n  <!-- PREHEADER EDITÁVEL: altere o texto abaixo para aparecer na prévia da caixa de entrada -->\n  <div style=\"display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all; color:#ffffff;\">\n    Aprenda métodos práticos para aumentar produtividade, reduzir desperdícios e identificar gargalos na sua operação.\n  </div>\n\n  <center style=\"width:100%; background-color:#f4f6fb;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f4f6fb;\">\n      <tr>\n        <td align=\"center\" style=\"padding:0;\">\n          <table role=\"presentation\" class=\"email-container\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:600px; max-width:600px; background-color:#ffffff;\">\n\n            <!-- BLOCO 01 | CABEÇALHO / HERO -->\n            <tr>\n              <td style=\"background-color:#164194; background-image:linear-gradient(135deg,#5a4d98 0%,#164194 52%,#008bd2 100%); padding:34px 28px 30px 28px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                  <tr>\n                    <td class=\"mobile-stack\" width=\"245\" style=\"width:245px; padding:0 24px 0 0;\">\n                      <!-- IMAGEM EDITÁVEL 01: faça upload da imagem principal no RD e substitua o src abaixo -->\n                      <img class=\"mobile-img\" src=\"https://via.placeholder.com/245x255/0b2d72/ffffff?text=UPLOAD%0AIMAGEM%0APRINCIPAL\" width=\"245\" height=\"255\" alt=\"Upload da imagem principal\" style=\"width:245px; max-width:245px; height:auto; border-radius:14px; background-color:#0b2d72;\">\n                    </td>\n                    <td class=\"mobile-stack mobile-center\" width=\"275\" style=\"width:275px; padding:4px 0 0 0; font-family:Calibri, Arial, Helvetica, sans-serif; color:#ffffff;\">\n                      <!-- TÍTULO EDITÁVEL -->\n                      <h1 class=\"hero-title\" style=\"margin:0 0 28px 0; font-family:Calibri, Arial, Helvetica, sans-serif; font-size:38px; line-height:42px; font-weight:700; font-style:italic; letter-spacing:0.2px; color:#ffffff; text-transform:uppercase;\">\n                        Imersão<br>Produtividade<br>Industrial\n                      </h1>\n                      <!-- DATA / LOCAL EDITÁVEIS -->\n                      <p style=\"margin:0; font-family:Calibri, Arial, Helvetica, sans-serif; font-size:20px; line-height:24px; font-weight:700; font-style:italic; color:#ffffff; text-transform:uppercase;\">\n                        26 de junho<br>\n                        das 8h30 às 17h30\n                      </p>\n                      <p style=\"margin:10px 0 0 0; font-family:Calibri, Arial, Helvetica, sans-serif; font-size:22px; line-height:26px; font-weight:700; font-style:italic; color:#ffffff; text-transform:uppercase;\">\n                        📍 CIEMG\n                      </p>\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <!-- BLOCO 02 | BENEFÍCIOS -->\n            <tr>\n              <td class=\"desktop-padding\" style=\"padding:38px 42px 28px 42px; background-color:#ffffff;\">\n                <!-- SUBTÍTULO EDITÁVEL -->\n                <h2 class=\"section-title\" style=\"margin:0 0 18px 0; font-family:Calibri, Arial, Helvetica, sans-serif; font-size:26px; line-height:31px; font-weight:700; font-style:italic; color:#5a4d98;\">\n                  Você vai aprender na prática como:\n                </h2>\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                  <!-- ITEM EDITÁVEL -->\n                  <tr>\n                    <td width=\"34\" valign=\"top\" style=\"width:34px; padding:4px 0 10px 0; font-family:Arial, Helvetica, sans-serif; font-size:22px; line-height:22px; color:#008bd2; font-weight:bold;\">✓</td>\n                    <td valign=\"top\" style=\"padding:0 0 10px 0; font-family:Calibri, Arial, Helvetica, sans-serif; font-size:21px; line-height:27px; color:#333333;\">Aumentar a produtividade da sua operação</td>\n                  </tr>\n                  <!-- ITEM EDITÁVEL -->\n                  <tr>\n                    <td width=\"34\" valign=\"top\" style=\"wi