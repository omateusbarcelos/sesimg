tation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                  <tr>\n                    <td class=\"mobile-stack mobile-center\" width=\"330\" style=\"width:330px; font-family:Calibri, Arial, Helvetica, sans-serif; color:#ffffff; padding:0 18px 18px 0;\">\n                      <!-- CONTATOS EDITÁVEIS -->\n                      <p style=\"margin:0 0 12px 0; font-family:Calibri, Arial, Helvetica, sans-serif; font-size:14px; line-height:19px; color:#ffffff;\">\n                        Em caso de dúvidas, entre em contato:\n                      </p>\n                      <p style=\"margin:0; font-family:Calibri, Arial, Helvetica, sans-serif; font-size:15px; line-height:23px; color:#ffffff;\">\n                        ☎ (31) 3472-3140<br>\n                        ☎ (31) 99847-7680<br>\n                        <a href=\"mailto:treinamentociemg@fiemg.com.br\" style=\"color:#ffffff; text-decoration:none; font-weight:700; font-style:italic;\">treinamentociemg@fiemg.com.br</a>\n                      </p>\n                    </td>\n                    <td class=\"mobile-stack\" width=\"170\" align=\"right\" style=\"width:170px; padding:0;\">\n                      <!-- LOGO EDITÁVEL: faça upload do logo CIEMG no RD e substitua o src abaixo -->\n                      <img class=\"mobile-img\" src=\"https://via.placeholder.com/170x70/164194/ffffff?text=UPLOAD%0ALOGO%0ACIEMG\" width=\"170\" height=\"70\" alt=\"Upload do logo CIEMG\" style=\"width:170px; max-width:170px; height:auto; background-color:#164194;\">\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n          </table>\n        </td>\n      </tr>\n    </table>\n  </center>\n</body>\n</html>\n"
